API_BASE_URL=https://api.api-tennis.com/tennis
ENDPOINT_PATH=/
OUTPUT_FORMAT=csv
PAGINATION_MODE=players_harvest     # <— novo modo

# sazonalidade / abrangência (ajuste como quiser)
TENNIS_SEASONS=2025,2024            # lista de temporadas para buscar fixtures
# OU, se preferir por datas (em vez de seasons), use YYYY-MM-DD:
# TENNIS_DATE_START=2025-01-01
# TENNIS_DATE_STOP=2025-12-31

# limites / segurança
HARVEST_MAX_TOURNAMENTS=50          # corta no máximo N torneios (tira ou aumenta depois)
HARVEST_CONCURRENCY=6               # pode herdar do CONCURRENCY padrão
